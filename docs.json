{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Suppio Documentation",
  "colors": {
    "primary": "#2563eb",
    "light": "#3b82f6",
    "dark": "#1d4ed8"
  },
  "favicon": {
    "light": "/images/colored_logo.png",
    "dark": "/images/colored_logo.png"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "info",
              "setup",
              "features",
              "billing",
              "frequently-asked-questions"
            ]
          },
          {
            "group": "Deployment",
            "pages": [
              "discord",
              "web-chat-widget",
              "hosted-support-page"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "overview",
              "context",
              "status-pages",
              "knowledge-gaps",
              "intelligence",
              "behavior",
              "response-images",
              "analytics",
              "usage",
              "commands",
              "actions",
              "customer-actions",
              "customer-action-executor-example",
              "customer-actions-https",
              "forums",
              "permissions"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Guide",
            "pages": [
              "agent-api"
            ]
          },
          {
            "group": "Reference",
            "openapi": "/api-reference/openapi.json",
            "pages": [
              "POST /v1/agents/{agentId}/responses"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/colored_logo.png",
    "dark": "/images/colored_logo.png",
    "href": "https://suppio.ai/"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://discord.gg/ZNRej7tDgZ"
      },
      {
        "label": "Website",
        "href": "https://suppio.ai/"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://suppio.ai/dashboard"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "description": "Learn how to set up and use Suppio across Discord, your website, support pages, and the API",
  "fonts": {
    "family": "Sora",
    "heading": {
      "family": "Space Grotesk"
    }
  },
  "background": {
    "color": {
      "dark": "#05070F"
    },
    "decoration": "grid"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  }
}
