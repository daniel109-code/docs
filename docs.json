              "intelligence",
              "actions",
              "behavior",
              "permissions",
              "analytics",
              "optimize",
              "usage"
            ]
          },
          {
            "group": "Guides",
            "pages": []
          },
          {
            "group": "Miscellaneous",
            "pages": [
              "billing"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "pages": [
          "what-is-new"
        ]
      }
    ]
  },
  "logo": "/images/Artboard_1_62x_light.png",
  "navbar": {
    "links": [
      {
        "label": "Support",
